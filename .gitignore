# 本地双击用的单文件产物（部署用的是 docs/index.html，那个要提交）
/考公练习追踪看板.html

# 飞书版的构建产物：由 feishu/build_feishu.py 生成，不进 main；
# 部署用的副本放在 feishu 分支的根目录 index.html
/feishu/dist/

# 分享版打包产物
/分享版/

# 测试依赖与产物
devtest/node_modules/
devtest/shots/
devtest/_out_*.xlsx

# 绑定数据文件夹后产生的用户数据（各自本地，不进仓库）
/data/*.json
/data/*.xlsx

# 原始数据表格：只保留在本地，不进公开仓库
/套卷复盘*.xlsx

# Python 字节码缓存（build_feishu.py 会 import build.py 而产生）
__pycache__/
*.pyc

# 编辑器 / 助手本地文件
.claude/
.vscode/
.idea/

# 系统
.DS_Store
Thumbs.db
desktop.ini
